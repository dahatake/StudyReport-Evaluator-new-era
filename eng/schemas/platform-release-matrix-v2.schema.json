{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:study-report-evaluator:platform-release-matrix:v2",
  "title": "StudyReport Evaluator Windows release matrix v2",
  "$comment": "C01 structural contract for requirements v4.5 sections 13.6/13.7 and ADR-0016. Schema validity is necessary, never sufficient for publication. C02 must reject duplicate JSON member names before validation; bind the expected repository, successful .github/workflows/release.yml candidate run, tag/source commit and stable product version; and cross-bind this matrix, the separately received candidateRecord, cleanHostEvidence and singleFilePackageEvidence. Validate those documents through their $defs entry points with this document's complete $defs available. C02 must compare exact basenames, byte counts, SHA-256 values, sidecar bytes, package/runtime identities and candidate descriptors against the actual candidate records and re-downloaded EXE/ZIP assets. C03 may generate this final matrix only after those checks and required clean-host results pass. The matrix is a closed set of exactly two rows: the Windows x64 single-file EXE and the Windows x64 ZIP. Only EXE, ZIP and their two sidecars are public assets. No schema match, hash, PASS field or human attestation automatically proves execution, a fresh host, authentication, publisher identity or production trust. No new platform, workflow or storage contract is introduced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "sourceCommit",
    "candidate",
    "candidateRecord",
    "cleanHostEvidence",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "productVersion": {
      "$ref": "#/$defs/stableProductVersion"
    },
    "sourceCommit": {
      "$ref": "#/$defs/sourceCommit"
    },
    "candidate": {
      "$ref": "#/$defs/candidateIdentity"
    },
    "candidateRecord": {
      "$ref": "#/$defs/candidateRecordDescriptor"
    },
    "cleanHostEvidence": {
      "$ref": "#/$defs/cleanHostEvidenceDescriptor"
    },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/windowsSingleFileRow" },
          { "$ref": "#/$defs/windowsZipRow" }
        ]
      },
      "allOf": [
        {
          "contains": { "$ref": "#/$defs/windowsSingleFileRow" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/windowsZipRow" },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "stableProductVersion": {
      "$comment": "Stable three-component SemVer only. The final negative lookahead also rejects trailing line terminators that a bare regex $ can accept.",
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9A-F]{64}$"
    },
    "positiveFileSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "windowsOsVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "windowsOsBuild": {
      "type": "integer",
      "minimum": 22000,
      "maximum": 2147483647
    },
    "windowsVerification": {
      "$comment": "P07 reports Windows, not Windows 11 inferred from a build number. A hosted Windows server/package test is not Windows 11 clean-host evidence. C02 must bind this metadata to the corresponding package evidence; the separately received cleanHostEvidence requires Windows 11.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "osName",
        "osVersion",
        "osBuild",
        "osArchitecture",
        "processArchitecture"
      ],
      "properties": {
        "osName": {
          "enum": ["Windows", "Windows 11"]
        },
        "osVersion": {
          "$ref": "#/$defs/windowsOsVersion"
        },
        "osBuild": {
          "$ref": "#/$defs/windowsOsBuild"
        },
        "osArchitecture": {
          "const": "X64"
        },
        "processArchitecture": {
          "const": "X64"
        }
      }
    },
    "candidateIdentity": {
      "$comment": "The repository is a bounded ASCII owner/name, not a URL or an allowlist decision. C02 must bind it to the expected actual repository and verify the workflow/run through trusted candidate metadata. Keep runId as a positive decimal string without numeric coercion or precision loss.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$(?![\\s\\S])"
        },
        "workflow": {
          "const": ".github/workflows/release.yml"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[1-9][0-9]*$(?![\\s\\S])"
        }
      }
    },
    "candidateRecordDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "release-candidate-record.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cleanHostEvidenceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "windows-singlefile-clean-host.evidence.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.exe"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.exe.sha256"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.exe.evidence.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsZipArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.zip"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsZipSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.zip.sha256"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsZipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.evidence.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "platform",
        "runtimeIdentifier",
        "publish",
        "status",
        "verification",
        "artifact",
        "sidecar",
        "evidence"
      ],
      "properties": {
        "artifactKind": {
          "const": "windows-singlefile-exe"
        },
        "platform": {
          "const": "windows"
        },
        "runtimeIdentifier": {
          "const": "win-x64"
        },
        "publish": {
          "const": true
        },
        "status": {
          "const": "PASS_REQUIRED"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsSingleFileArtifact"
        },
        "sidecar": {
          "$ref": "#/$defs/windowsSingleFileSidecar"
        },
        "evidence": {
          "$ref": "#/$defs/windowsSingleFileEvidence"
        }
      }
    },
    "windowsZipRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "platform",
        "runtimeIdentifier",
        "publish",
        "status",
        "verification",
        "artifact",
        "sidecar",
        "evidence"
      ],
      "properties": {
        "artifactKind": {
          "const": "windows-zip"
        },
        "platform": {
          "const": "windows"
        },
        "runtimeIdentifier": {
          "const": "win-x64"
        },
        "publish": {
          "const": true
        },
        "status": {
          "const": "PASS_REQUIRED"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsZipArtifact"
        },
        "sidecar": {
          "$ref": "#/$defs/windowsZipSidecar"
        },
        "evidence": {
          "$ref": "#/$defs/windowsZipEvidence"
        }
      }
    },
    "candidateRecord": {
      "$comment": "Separately received release-candidate-record.json. This is a package/descriptors record, not the final matrix or clean-host eligibility. Its two rows intentionally have no platform, runtimeIdentifier, publish or status fields. C02 must verify the candidate's actual package test record, identities and descriptors; C03 must not invent a clean-host result while creating a candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "evidenceKind",
        "productVersion",
        "sourceCommit",
        "candidate",
        "requiredTests",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceKind": {
          "const": "windows-release-candidate"
        },
        "productVersion": {
          "$ref": "#/$defs/stableProductVersion"
        },
        "sourceCommit": {
          "$ref": "#/$defs/sourceCommit"
        },
        "candidate": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "requiredTests": {
          "const": "PASS"
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/windowsSingleFileCandidateRow" },
              { "$ref": "#/$defs/windowsZipCandidateRow" }
            ]
          },
          "allOf": [
            {
              "contains": { "$ref": "#/$defs/windowsSingleFileCandidateRow" },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "$ref": "#/$defs/windowsZipCandidateRow" },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "windowsSingleFileCandidateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "verification", "artifact", "sidecar", "evidence"],
      "properties": {
        "artifactKind": {
          "const": "windows-singlefile-exe"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsSingleFileArtifact"
        },
        "sidecar": {
          "$ref": "#/$defs/windowsSingleFileSidecar"
        },
        "evidence": {
          "$ref": "#/$defs/windowsSingleFileEvidence"
        }
      }
    },
    "windowsZipCandidateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "verification", "artifact", "sidecar", "evidence"],
      "properties": {
        "artifactKind": {
          "const": "windows-zip"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsZipArtifact"
        },
        "sidecar": {
          "$ref": "#/$defs/windowsZipSidecar"
        },
        "evidence": {
          "$ref": "#/$defs/windowsZipEvidence"
        }
      }
    },
    "singleFileRuntime": {
      "$comment": "Exactly the five runtime fields emitted by P07. cliSha256 is measured uppercase SHA-256, not an invented fixed hash. C02 must verify the actual bundled CLI identity and cross-bind it and all four fixed versions across package and clean-host evidence; the observer's installed runtime is not the bundled runtime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnetSdk", "dotnetRuntime", "copilotSdk", "cliVersion", "cliSha256"],
      "properties": {
        "dotnetSdk": {
          "const": "10.0.400"
        },
        "dotnetRuntime": {
          "const": "10.0.11"
        },
        "copilotSdk": {
          "const": "1.0.11"
        },
        "cliVersion": {
          "const": "1.0.79"
        },
        "cliSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observationRecord": {
      "$comment": "Metadata-only descriptor of a sanitized human observation record: fileName, bytes and sha256. Its bounded ASCII basename is neither a path nor a URL; traversal, trailing dots, control characters and DOS device basenames are rejected. Do not embed usernames, tokens, device codes, student content, environment dumps or raw logs. A reference/hash identifies a human record, not cryptographic proof of execution; receiving JSON does not fetch or publish that record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?!.*\\.\\.)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$(?![\\s\\S])"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cleanHostTestResult": {
      "$comment": "CH-01 through CH-06 require PASS and a non-null record even when operations is zero. D-06 is adopted: CH-06 cannot be omitted, NOT_RUN or N/A. ADV-01/02 may fail or remain NOT_RUN without blocking required acceptance; NOT_RUN means zero operations and null record, whereas executed advisory tests require a record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "operations", "record"],
      "properties": {
        "id": {
          "enum": ["CH-01", "CH-02", "CH-03", "CH-04", "CH-05", "CH-06", "ADV-01", "ADV-02"]
        },
        "status": {
          "enum": ["PASS", "FAIL", "NOT_RUN"]
        },
        "operations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "record": {
          "oneOf": [
            { "$ref": "#/$defs/observationRecord" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["id"],
            "properties": {
              "id": {
                "enum": ["CH-01", "CH-02", "CH-03", "CH-04", "CH-05", "CH-06"]
              }
            }
          },
          "then": {
            "properties": {
              "status": { "const": "PASS" }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "NOT_RUN" }
            }
          },
          "then": {
            "properties": {
              "operations": { "const": 0 },
              "record": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "record": { "$ref": "#/$defs/observationRecord" }
            }
          }
        }
      ]
    },
    "cleanHostEvidence": {
      "$comment": "Separately received windows-singlefile-clean-host.evidence.json, never a synthesized result from P07. This closed document carries sanitized human attestations about the exact candidate EXE on a fresh Windows 11 x64 standard-user host. C02 must bind candidate/source/version/package/runtime to independently checked candidate data, validate the UTC calendar timestamp and compare observed protection/operations with the approved scope. Schema validity and hashes alone do not establish the truth of the attestations, personal login, offline operation or unchanged protection settings. Never place the received JSON or observation records among the four public assets.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "evidenceKind",
        "measuredAtUtc",
        "productVersion",
        "sourceCommit",
        "candidate",
        "package",
        "runtime",
        "host",
        "protection",
        "measurements",
        "tests"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceKind": {
          "const": "windows-singlefile-clean-host"
        },
        "measuredAtUtc": {
          "$comment": "UTC ISO 8601 with literal T/Z only, at most 40 characters. Draft 2020-12 format may be annotation-only; C02 must also parse and reject invalid calendar dates rather than treating a regex match as sufficient.",
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,19})?Z$(?![\\s\\S])"
        },
        "productVersion": {
          "$ref": "#/$defs/stableProductVersion"
        },
        "sourceCommit": {
          "$ref": "#/$defs/sourceCommit"
        },
        "candidate": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "package": {
          "$ref": "#/$defs/windowsSingleFileArtifact"
        },
        "runtime": {
          "$ref": "#/$defs/singleFileRuntime"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "osName",
            "edition",
            "osVersion",
            "osBuild",
            "architecture",
            "standardUser",
            "fresh",
            "additionalDependencies"
          ],
          "properties": {
            "osName": {
              "const": "Windows 11"
            },
            "edition": {
              "enum": ["Home", "Pro", "Enterprise", "Education", "ProEducation", "ProWorkstations", "EnterpriseLTSC"]
            },
            "osVersion": {
              "$ref": "#/$defs/windowsOsVersion"
            },
            "osBuild": {
              "$ref": "#/$defs/windowsOsBuild"
            },
            "architecture": {
              "const": "X64"
            },
            "standardUser": {
              "const": true
            },
            "fresh": {
              "const": true
            },
            "additionalDependencies": {
              "$comment": "All nine additional dependencies must be absent; OS-supplied .NET Framework is not an additional .NET runtime. A development host with PATH/environment isolation is not an OS-only host.",
              "type": "object",
              "additionalProperties": false,
              "required": ["dotnetSdk", "dotnetRuntime", "powerShell6Plus", "nodeNpm", "git", "githubCli", "copilotCli", "office", "ide"],
              "properties": {
                "dotnetSdk": { "const": false },
                "dotnetRuntime": { "const": false },
                "powerShell6Plus": { "const": false },
                "nodeNpm": { "const": false },
                "git": { "const": false },
                "githubCli": { "const": false },
                "copilotCli": { "const": false },
                "office": { "const": false },
                "ide": { "const": false }
              }
            }
          }
        },
        "protection": {
          "$comment": "Protection settings are observations, not instructions to disable protection. Pre-existing Disabled/Off states are permitted only with unchanged settings and approval attested; never remove MOTW or bypass a refusal. One launch gesture excludes warning actions. C02 must enforce WarnedThenAllowed => positive warningActions, Allowed => zero, and compare the observations to the approved scope; withinApprovedScope=true alone proves nothing.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "motw",
            "smartScreen",
            "smartAppControl",
            "enterprisePolicy",
            "settingsUnchanged",
            "launchOutcome",
            "launchGestures",
            "warningActions",
            "withinApprovedScope"
          ],
          "properties": {
            "motw": {
              "const": true
            },
            "smartScreen": {
              "enum": ["Enabled", "Disabled", "Managed"]
            },
            "smartAppControl": {
              "enum": ["On", "Evaluation", "Off", "NotAvailable"]
            },
            "enterprisePolicy": {
              "enum": ["NotConfigured", "Allowed", "Warning"]
            },
            "settingsUnchanged": {
              "const": true
            },
            "launchOutcome": {
              "enum": ["Allowed", "WarnedThenAllowed"]
            },
            "launchGestures": {
              "const": 1
            },
            "warningActions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "withinApprovedScope": {
              "const": true
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["launchOutcome"],
                "properties": {
                  "launchOutcome": { "const": "WarnedThenAllowed" }
                }
              },
              "then": {
                "properties": {
                  "warningActions": { "minimum": 1 }
                }
              },
              "else": {
                "properties": {
                  "warningActions": { "const": 0 }
                }
              }
            }
          ]
        },
        "measurements": {
          "$comment": "Observed sizes and timings only. Safe integer bounds protect interchange precision, not a performance SLA; there is no maximum startup-time acceptance target.",
          "type": "object",
          "additionalProperties": false,
          "required": ["extractedBytes", "coldStartMilliseconds", "warmStartMilliseconds"],
          "properties": {
            "extractedBytes": {
              "$ref": "#/$defs/positiveFileSize"
            },
            "coldStartMilliseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "warmStartMilliseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cleanHostTestResult"
          },
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/cleanHostTestResult",
                "properties": { "id": { "const": "CH-01" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/cleanHostTestResult",
                "properties": { "id": { "const": "CH-02" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
