<Project>
  <!-- Keep both groups App-only even when PublishProfileFullPath reaches project references. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'StudyReportEvaluator.App'">
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Keep the validated payload stable when global.json rolls the SDK forward. -->
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Nonrecommended .NET Core 3.1 compatibility mode, potentially removed in future releases.
         Accepted for the fixed S01 configuration by dev/docs/adr/0016-windows-one-action-startup.md. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'StudyReportEvaluator.App'">
    <!-- Match the dedicated single-file lock; this build tool does not enable trimming. -->
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks">
      <ILLinkPackVersion Condition="'%(KnownILLinkPack.TargetFramework)' == 'net10.0'">10.0.11</ILLinkPackVersion>
    </KnownILLinkPack>
  </ItemGroup>

  <!-- Register the exact public allowlist from scripts/package-windows.ps1 before bundling.
       Each source has one explicit publish-relative Link; no repository globs or post-bundle copy. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'StudyReportEvaluator.App'">
    <Content Include="$(MSBuildProjectDirectory)\..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\README.md" Link="docs\README.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\getting-started.md" Link="docs\getting-started.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\features.md" Link="docs\features.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\custom-evaluator-guide.md" Link="docs\custom-evaluator-guide.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\technical-guid.md" Link="docs\technical-guid.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\prompt-launch.md" Link="docs\prompt-launch.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\privacy-and-data-handling.md" Link="docs\privacy-and-data-handling.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\troubleshooting.md" Link="docs\troubleshooting.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\settings.md" Link="docs\settings.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\third-party-notices.md" Link="docs\third-party-notices.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\docs\result-excel-description.md" Link="docs\result-excel-description.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\README.md" Link="images\README.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\architecture-overview.svg" Link="images\architecture-overview.svg" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\technical-architecture.svg" Link="images\technical-architecture.svg" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\evaluation-message-flow.svg" Link="images\evaluation-message-flow.svg" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\01-input-workbook.png" Link="images\01-input-workbook.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\02-input-mapping.png" Link="images\02-input-mapping.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\03-design-knowledge.png" Link="images\03-design-knowledge.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\04-design-custom-prompt.png" Link="images\04-design-custom-prompt.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\05-execution-auto.png" Link="images\05-execution-auto.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\06-results-review.png" Link="images\06-results-review.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\07-output-export.png" Link="images\07-output-export.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\images\08-settings.png" Link="images\08-settings.png" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
  </ItemGroup>
</Project>